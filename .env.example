# Copy to .env.local (git-ignored) and fill in.

# The Mangla backend, including its api.prefix (/app):
#   local:  http://localhost:8000/app   (python -m app in mangla_project_backend)
#   Azure:  https://<function-app-host>/app   (see the backend's docs/Deployment.md)
VITE_API_BASE_URL=http://localhost:8000/app

# No login endpoint yet: after the demo OTP (123456) the app signs in as this users.user_id.
# python -m scripts.seed_demo_eat in the backend prints the demo buyer's id.
VITE_DEMO_USER_ID=
